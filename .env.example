# Coleção
# corpus/ é o padrão e não é versionado.
BASEIA_CORPUS_DIR=corpus

# Todos os dados produzidos pelo pipeline ficam abaixo deste diretório.
BASEIA_DATA_DIR=data
MINERU_OUTPUT_DIR=data/mineru

# MinerU
MINERU_CONCURRENCY_PER_POD=16
MINERU_API_URLS=
MINERU_RETRIES=2
MINERU_BACKEND=pipeline
MINERU_OVERWRITE=false

# RunPod: nome exato do template privado existente na sua conta
RUNPOD_TEMPLATE_NAME=mineru-api
RUNPOD_NETWORK_VOLUME_ID=tgj0jmkxnt
RUNPOD_WORKLOAD=computer-vision
RUNPOD_HARDWARE_PROFILE=mineru-80
RUNPOD_MIN_VRAM_GB=80
RUNPOD_MIN_VCPU_COUNT=128
RUNPOD_MIN_MEMORY_GB=512
RUNPOD_MAX_COST_PER_HOUR=12.50
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_MIN_CUDA_VERSION=12.8
RUNPOD_POD_COUNT=0
RUNPOD_GPU_COUNT=8
RUNPOD_CONTAINER_DISK_GB=80
RUNPOD_DOCKER_ARGS=
RUNPOD_API_PORT=8000
RUNPOD_NAME_PREFIX=baseia-mineru

# Trava de custo caso o processo local morra antes do finally
RUNPOD_TERMINATE_AFTER=12h
RUNPOD_STARTUP_TIMEOUT_SECONDS=1800
RUNPOD_STARTUP_POLL_SECONDS=10
# Timeouts MinerU
MINERU_HEALTH_TIMEOUT_SECONDS=30
MINERU_SUBMIT_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_TASK_TIMEOUT_SECONDS=3600
MINERU_RESULT_TIMEOUT_SECONDS=3600

# Proteção contra falhas transitórias de conexão.
MINERU_CIRCUIT_FAILURE_THRESHOLD=3
MINERU_CIRCUIT_WINDOW_SECONDS=60
MINERU_CIRCUIT_COOLDOWN_SECONDS=30
MINERU_CIRCUIT_RECOVERY_SUCCESSES=2

# Autotuning orientado exclusivamente por vazão sustentada.
MINERU_AUTOTUNE_SETTLING_SECONDS=30
MINERU_AUTOTUNE_WINDOW_SECONDS=120
MINERU_AUTOTUNE_MIN_SAMPLES=16


# S3 compatível no host (SeaweedFS do compose, MinIO ou serviço gerenciado)
BASEIA_S3_ENDPOINT_URL=http://127.0.0.1:8333
BASEIA_S3_BUCKET=baseia
BASEIA_S3_MAX_CONCURRENCY=16
AWS_ACCESS_KEY_ID=baseia
AWS_SECRET_ACCESS_KEY=baseia-secret
AWS_DEFAULT_REGION=us-east-1
SEAWEED_S3_PORT=8333
SEAWEED_FILER_PORT=8888
SEAWEED_MASTER_PORT=9333

# Serviços locais: catálogo, storage e banco vetorial
BASEIA_BIND_HOST=127.0.0.1
POSTGRES_DB=baseia
POSTGRES_USER=baseia
POSTGRES_PASSWORD=baseia
POSTGRES_PORT=5432
CATALOG_API_PORT=8088
BASEIA_CATALOG_API_URL=http://127.0.0.1:8088
BASEIA_REQUIRE_CATALOG_TOKEN=false
BASEIA_CATALOG_API_TOKEN=

QDRANT_VERSION=v1.18.3
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# A chave já configurada no ambiente do usuário continua sendo reutilizada.
OPENROUTER_API_KEY=

# Render e chunking permanecem locais até promote-s3.
BASEIA_RENDER_PUBLISH_S3=false
