# Todos os dados produzidos pelo pipeline ficam abaixo deste diretório.
BASEIA_DATA_DIR=data
# Saídas agregadas de cada execução; artefatos individuais ficam em documents/.
EXTRACTION_OUTPUT_DIR=data/extraction

# Estado durável: um manifesto JSON atômico por documento em data/documents/.
# Fila, telemetria e inventário de endpoints são transitórios.

# MinerU
MINERU_VERSION=3.4.4
# Endpoint HTTP padrão. Pode ser substituído no comando `poe extract start URL`.
MINERU_API_URL=http://127.0.0.1:8000
# Capacidade inicial do cliente por endpoint. O autotune parte deste valor e decide
# ajustes pelo pages/min sustentado. CPU alta sustentada só adia aumentos.
MINERU_CONCURRENCY_PER_ENDPOINT=16
MINERU_AUTOTUNE_CPU_HIGH_PERCENT=90
MINERU_AUTOTUNE_CPU_HIGH_SAMPLES=3
MINERU_AUTOTUNE_CPU_RECOVERY_PERCENT=85
MINERU_RETRIES=2
MINERU_BACKEND=pipeline
MINERU_OVERWRITE=false
# Ative somente quando todos os endpoints enxergarem o mesmo repositório de
# resultados persistidos.
MINERU_SHARED_RESULTS=false

# Resultados só são liberados após a persistência atômica no Volume Disk.
# Não use retenção curta: 0 desativa a limpeza automática do MinerU.
MINERU_API_TASK_RETENTION_SECONDS=0
MINERU_API_TASK_CLEANUP_INTERVAL_SECONDS=60

# Auditoria
AUDIT_TEXTLESS_PAGE_WARN_RATIO=0.5
AUDIT_MIN_MIDDLE_BYTES=1024
AUDIT_REVIEW_SAMPLE_SIZE=75

# Timeouts MinerU
MINERU_HEALTH_TIMEOUT_SECONDS=30
MINERU_SUBMIT_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=1
MINERU_TASK_TIMEOUT_SECONDS=3600
MINERU_RESULT_TIMEOUT_SECONDS=3600
MINERU_ENDPOINT_WAIT_TIMEOUT_SECONDS=300
# Circuit breaker de admissão: não reduz workers; bloqueia apenas novos POSTs.
MINERU_CIRCUIT_FAILURE_THRESHOLD=3
MINERU_CIRCUIT_WINDOW_SECONDS=60
MINERU_CIRCUIT_COOLDOWN_SECONDS=30
MINERU_CIRCUIT_RECOVERY_SUCCESSES=2
# Autotuning por pages/min: settling + duas janelas sustentadas por nível.
MINERU_AUTOTUNE_SETTLING_SECONDS=30
MINERU_AUTOTUNE_WINDOW_SECONDS=120
MINERU_AUTOTUNE_MIN_SAMPLES=16
