# Coleção
# corpus/ é o padrão e não é versionado.
BASEIA_CORPUS_DIR=corpus

# Todos os dados produzidos pelo pipeline ficam abaixo deste diretório.
BASEIA_DATA_DIR=data
# Permite iniciar uma nova geração de artefatos sem mover a anterior.
MINERU_OUTPUT_DIR=

# Estado durável: um manifesto JSON atômico por SHA-256 em data/mineru/manifests/.
# Fila, telemetria e inventário de pods são transitórios.

# MinerU
MINERU_VERSION=3.4.4
# Capacidade inicial do cliente por pod. O autotune parte deste valor e decide
# ajustes pelo pages/min sustentado. CPU alta sustentada só adia aumentos.
MINERU_CONCURRENCY_PER_POD=16
MINERU_AUTOTUNE_CPU_HIGH_PERCENT=90
MINERU_AUTOTUNE_CPU_HIGH_SAMPLES=3
MINERU_AUTOTUNE_CPU_RECOVERY_PERCENT=85
MINERU_RETRIES=2
MINERU_BACKEND=pipeline
MINERU_OVERWRITE=false
MINERU_API_URLS=

# Resultados só são liberados após a persistência atômica no Volume Disk.
# Não use retenção curta: 0 desativa a limpeza automática do MinerU.
MINERU_API_TASK_RETENTION_SECONDS=0
MINERU_API_TASK_CLEANUP_INTERVAL_SECONDS=60

# Auditoria
AUDIT_TEXTLESS_PAGE_WARN_RATIO=0.5
AUDIT_MIN_MIDDLE_BYTES=1024
AUDIT_REVIEW_SAMPLE_SIZE=75

# RunPod: nome exato do template privado existente na sua conta
RUNPOD_TEMPLATE_NAME=BaseIA MinerU
# Enquanto RUNPOD_NETWORK_VOLUME_ID estiver definido, novos pods usam esse
# Network Volume em /workspace. Mantenha-o configurado até baixar e reconciliar
# todos os pacotes desta extração.
RUNPOD_NETWORK_VOLUME_ID=
# Depois da migração, deixe o ID acima vazio para novos pods usarem um Volume
# Disk por pod, persistente entre stop/start enquanto o pod não for deletado.
RUNPOD_VOLUME_DISK_GB=100
RUNPOD_WORKLOAD=computer-vision
# Perfil otimizado para MinerU: evita GPUs caras sem CPU proporcional.
RUNPOD_HARDWARE_PROFILE=mineru-80
RUNPOD_MIN_VRAM_GB=24
RUNPOD_MIN_VCPU_COUNT=128
RUNPOD_MIN_MEMORY_GB=512
RUNPOD_MAX_COST_PER_HOUR=25.00
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_MIN_CUDA_VERSION=12.8
# Configuração-alvo: 4 pods com 8 GPUs cada.
RUNPOD_POD_COUNT=4
RUNPOD_GPU_COUNT=8
RUNPOD_CONTAINER_DISK_GB=80
RUNPOD_DOCKER_ARGS=
RUNPOD_API_PORT=8000
RUNPOD_NAME_PREFIX=baseia-mineru

RUNPOD_STARTUP_TIMEOUT_SECONDS=1800
RUNPOD_STARTUP_POLL_SECONDS=10

# Timeouts MinerU
MINERU_HEALTH_TIMEOUT_SECONDS=30
MINERU_SUBMIT_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=1
MINERU_TASK_TIMEOUT_SECONDS=3600
MINERU_RESULT_TIMEOUT_SECONDS=3600
# Circuit breaker de admissão: não reduz workers; bloqueia apenas novos POSTs.
MINERU_CIRCUIT_FAILURE_THRESHOLD=3
MINERU_CIRCUIT_WINDOW_SECONDS=60
MINERU_CIRCUIT_COOLDOWN_SECONDS=30
MINERU_CIRCUIT_RECOVERY_SUCCESSES=2
# Autotuning por pages/min: settling + duas janelas sustentadas por nível.
MINERU_AUTOTUNE_SETTLING_SECONDS=30
MINERU_AUTOTUNE_WINDOW_SECONDS=120
MINERU_AUTOTUNE_MIN_SAMPLES=16
