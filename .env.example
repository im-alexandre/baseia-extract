# Coleção
# corpus/ é o padrão e não é versionado.
BASEIA_CORPUS_DIR=corpus

# Todos os dados produzidos pelo pipeline ficam abaixo deste diretório.
BASEIA_DATA_DIR=data

# MinerU
MINERU_VERSION=3.4.0
MINERU_WORKERS_PER_POD=8
MINERU_RETRIES=2
MINERU_BACKEND=pipeline
MINERU_OVERWRITE=false

# Auditoria
AUDIT_TEXTLESS_PAGE_WARN_RATIO=0.5
AUDIT_MIN_MIDDLE_BYTES=1024
AUDIT_REVIEW_SAMPLE_SIZE=75

# RunPod: nome exato do template privado existente na sua conta
RUNPOD_TEMPLATE_NAME=BaseIA MinerU
RUNPOD_GPU_ID=NVIDIA GeForce RTX 5090
RUNPOD_POD_COUNT=1
RUNPOD_GPU_COUNT=1
RUNPOD_API_PORT=8000
RUNPOD_NAME_PREFIX=baseia-mineru
NETWORK_VOLUME_ID=95hlga7zon

# Trava de custo caso o processo local morra antes do finally
RUNPOD_TERMINATE_AFTER=12h
RUNPOD_STARTUP_TIMEOUT_SECONDS=1800
RUNPOD_STARTUP_POLL_SECONDS=10

# Timeouts MinerU
MINERU_HEALTH_TIMEOUT_SECONDS=30
MINERU_SUBMIT_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=1
MINERU_TASK_TIMEOUT_SECONDS=3600
MINERU_RESULT_TIMEOUT_SECONDS=300
