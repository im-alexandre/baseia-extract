# Diretórios
BASEIA_CORPUS_DIR=D:/corpus
BASEIA_DATA_DIR=data
BASEIA_ARTIFACTS_DIR=artifacts
BASEIA_INVENTORY_PATH=data/inventory/inventory.csv
BASEIA_MINERU_OUTPUT_DIR=artifacts/mineru/extraction
BASEIA_IR_DIR=artifacts/ir
BASEIA_STRUCTURE_DIR=artifacts/structure
BASEIA_CHUNKS_DIR=artifacts/chunks

# MinerU
MINERU_WORKERS_PER_POD=12
MINERU_RETRIES=2
MINERU_BACKEND=pipeline
MINERU_OVERWRITE=false

# RunPod temporário gerenciado pela task `poe extract`
RUNPOD_TEMPLATE_NAME=BaseIA MinerU
RUNPOD_GPU_ID=NVIDIA GeForce RTX 5090
RUNPOD_POD_COUNT=1
RUNPOD_GPU_COUNT=1
RUNPOD_API_PORT=8000
RUNPOD_NAME_PREFIX=baseia-mineru

# Trava de custo: termina o pod mesmo se o processo local morrer antes do finally
RUNPOD_TERMINATE_AFTER=12h
RUNPOD_STARTUP_TIMEOUT_SECONDS=1800
RUNPOD_STARTUP_POLL_SECONDS=10

# Timeouts MinerU
MINERU_HEALTH_TIMEOUT_SECONDS=30
MINERU_SUBMIT_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=1
MINERU_TASK_TIMEOUT_SECONDS=3600
MINERU_RESULT_TIMEOUT_SECONDS=300
