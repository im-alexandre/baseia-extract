# Dados locais
BASEIA_DATA_DIR=data
EXTRACTION_OUTPUT_DIR=data/extraction

# Contexto de coleção. Quando vazia, `poe collection use` define a coleção
# atual no diretório de dados do usuário (fora desta worktree).
BASEIA_COLLECTION=
# Override opcional do registro global; vazio usa o diretório padrão do SO.
BASEIA_COLLECTIONS_DIR=

# Bind do compose. Mantenha localhost em desenvolvimento.
BASEIA_BIND_HOST=127.0.0.1

# MinerU acessado pelo CLI local. URLs adicionais podem ser passadas ao Poe.
MINERU_VERSION=3.4.4
MINERU_SHM_SIZE=8gb
MINERU_API_URL=http://127.0.0.1:8000
# Lista opcional separada por vírgulas para coleções com múltiplos serviços.
MINERU_API_URLS=
MINERU_CONCURRENCY_PER_ENDPOINT=3
MINERU_RETRIES=2
MINERU_BACKEND=pipeline
MINERU_OVERWRITE=false
MINERU_SHARED_RESULTS=false

# Pool HTTP compartilhado para dezenas/centenas de tasks concorrentes.
MINERU_HTTP_MAX_CONNECTIONS=256
MINERU_HTTP_MAX_KEEPALIVE_CONNECTIONS=128
MINERU_HTTP_KEEPALIVE_EXPIRY_SECONDS=30

# Materializa resultados persistidos em S3 para permitir render local.
MINERU_MATERIALIZE_RESULTS=true
MINERU_S3_DOWNLOAD_CONCURRENCY=4

# Render local continua local por padrão. Ative para publicar canonical/**
# e o manifest no S3, concluindo o stage render no catálogo.
BASEIA_RENDER_PUBLISH_S3=false
BASEIA_RENDER_PUBLISH_CONCURRENCY=4
BASEIA_RENDER_S3_TRANSFER_CONCURRENCY=4

# Timeouts e polling
MINERU_HEALTH_TIMEOUT_SECONDS=30
MINERU_SUBMIT_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=1
MINERU_TASK_TIMEOUT_SECONDS=3600
MINERU_RESULT_TIMEOUT_SECONDS=3600
MINERU_ENDPOINT_WAIT_TIMEOUT_SECONDS=300

# Circuit breaker e autotune do cliente
MINERU_CIRCUIT_FAILURE_THRESHOLD=3
MINERU_CIRCUIT_WINDOW_SECONDS=60
MINERU_CIRCUIT_COOLDOWN_SECONDS=30
MINERU_CIRCUIT_RECOVERY_SUCCESSES=2
MINERU_AUTOTUNE_SETTLING_SECONDS=30
MINERU_AUTOTUNE_WINDOW_SECONDS=120
MINERU_AUTOTUNE_MIN_SAMPLES=16
MINERU_AUTOTUNE_CPU_HIGH_PERCENT=90
MINERU_AUTOTUNE_CPU_HIGH_SAMPLES=3
MINERU_AUTOTUNE_CPU_RECOVERY_PERCENT=85

# Catálogo local
POSTGRES_DB=baseia
POSTGRES_USER=baseia
POSTGRES_PASSWORD=baseia
POSTGRES_PORT=5432
BASEIA_DATABASE_URL=postgresql+psycopg://baseia:baseia@127.0.0.1:5432/baseia
BASEIA_CATALOG_API_URL=http://127.0.0.1:8088
# Gere um token forte antes de expor a API. Vazio só é aceitável em localhost.
BASEIA_CATALOG_API_TOKEN=
BASEIA_REQUIRE_CATALOG_TOKEN=false
CATALOG_API_HOST=127.0.0.1
CATALOG_API_PORT=8088

# S3 compatível no host (SeaweedFS do compose, MinIO ou serviço gerenciado)
BASEIA_S3_ENDPOINT_URL=http://127.0.0.1:8333
BASEIA_S3_BUCKET=baseia
BASEIA_S3_MAX_CONCURRENCY=16
AWS_ACCESS_KEY_ID=baseia
AWS_SECRET_ACCESS_KEY=baseia-secret
AWS_DEFAULT_REGION=us-east-1
SEAWEED_S3_PORT=8333
SEAWEED_FILER_PORT=8888
SEAWEED_MASTER_PORT=9333

# Container MinerU. Os defaults persistentes usam os nomes DNS do compose.
# Para uma sandbox isolada do pipeline, defina MINERU_RESULT_STORE=filesystem.
MINERU_RESULT_STORE=s3
# Defina estes campos no host somente quando o MinerU persistir seus
# intermediários em um S3 diferente do storage canônico da coleção.
# Os valores de credencial nunca são gravados em baseia.collection.yaml.
MINERU_RESULT_S3_ENDPOINT_URL=
MINERU_RESULT_S3_BUCKET=
MINERU_RESULT_S3_REGION=
MINERU_RESULT_S3_ACCESS_KEY_ID=
MINERU_RESULT_S3_SECRET_ACCESS_KEY=
MINERU_CATALOG_API_URL=http://catalog-api:8088
MINERU_S3_ENDPOINT_URL=http://seaweedfs:8333
MINERU_PERSISTENCE_CONCURRENCY=4
MINERU_S3_UPLOAD_CONCURRENCY=8
MINERU_ROUTER_MAX_CONCURRENT_REQUESTS=128
MINERU_MAX_UNPERSISTED_TASKS=256
MINERU_MIN_FREE_DISK_GIB=10
MINERU_MIN_FREE_DISK_PERCENT=10
BASEIA_STAGE_LEASE_SECONDS=7200
MINERU_API_TASK_RETENTION_SECONDS=0
MINERU_API_TASK_CLEANUP_INTERVAL_SECONDS=60
MINERU_API_PORT=8000

# Temporal (perfil production; workflows ainda não são requisito)
TEMPORAL_POSTGRES_PASSWORD=temporal
TEMPORAL_VERSION=1.31.2
TEMPORAL_UI_VERSION=2.34.0
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080

# Auditoria
AUDIT_TEXTLESS_PAGE_WARN_RATIO=0.5
AUDIT_MIN_MIDDLE_BYTES=1024
AUDIT_REVIEW_SAMPLE_SIZE=75
